<?xml version="1.0" encoding="utf-8"?>
<!-- 权限添加设置页：勾选要添加的权限 + 签名开关 + 输出路径 + 底部保存 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray"
    android:orientation="vertical">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/blue"
            android:textSize="30sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="权限添加设置"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="44dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- 设置内容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 权限列表卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="要添加的权限"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="勾选后先写入 APK 的 AndroidManifest.xml，再向应用入口类注入运行时申请代码（已授予的会自动跳过）"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/cbReadExternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="读取外部存储\n（相册扫描，Android 12 及以下）"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbReadMediaImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="读取图片媒体\n（相册扫描，Android 13 及以上）"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbManageExternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="所有文件访问（最强权限）\n（未授予时自动跳转系统设置页授权）"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbInternet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="网络访问（上传数据到服务器）"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbWriteExternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="写入外部存储\n（保存本地副本，Android 9 及以下）"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 签名卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="签名打包"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="关闭后重打包不签名，输出未签名 APK（无法直接安装）"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/permSignSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="修改后签名打包"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 输出路径卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="输出路径"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="修改后的 APK 自动保存到该绝对路径目录，需授予存储权限，默认与资源解析相同，可单独修改"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/permPathInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edit_bg"
                    android:hint="/sdcard/APK解析工具（可含子目录，如 /sdcard/工具输出）"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="10dp"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_hint"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部保存栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="12dp">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/btn_primary"
            android:backgroundTint="@null"
            android:text="保存设置"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
