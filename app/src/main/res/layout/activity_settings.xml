<?xml version="1.0" encoding="utf-8"?>
<!-- 输出设置页：顶部栏 + 语言/分辨率/版本三张卡片 + 底部保存 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray"
    android:orientation="vertical">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/blue"
            android:textSize="30sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="输出设置"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="44dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- 设置内容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 语言卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="语言"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="同一资源 ID 在不同语言下会重复出现，选择要保留的语言"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/langGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioLangAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="全部显示（默认）"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioLangDefault"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="仅默认（无语言限定）"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioLangCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="自定义选择"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/langCustomBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="默认（无语言限定）始终保留，再勾选要保留的语言"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/langGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <EditText
                        android:id="@+id/langOther"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/edit_bg"
                        android:hint="其他基础语言码，逗号分隔，如 hi,my"
                        android:inputType="text"
                        android:maxLines="1"
                        android:padding="10dp"
                        android:textColor="@color/text_main"
                        android:textColorHint="@color/text_hint"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 分辨率卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分辨率"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="同一资源 ID 在不同分辨率下会重复出现，选择要保留的分辨率"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/densityGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioDensityAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="全部显示（默认）"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioDensityDefault"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="仅默认（无分辨率限定）"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioDensityCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="自定义选择"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/densityCustomBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="无分辨率限定（nodpi）始终保留，再勾选要保留的分辨率"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/densityGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <EditText
                        android:id="@+id/densityOther"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/edit_bg"
                        android:hint="其他分辨率，逗号分隔，如 sw800dp,480dpi"
                        android:inputType="text"
                        android:maxLines="1"
                        android:padding="10dp"
                        android:textColor="@color/text_main"
                        android:textColorHint="@color/text_hint"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 版本卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="版本"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="同一配置存在多个 SDK 版本时，只保留 sdkVersion 最高的一个"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/versionGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioVersionAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="全部显示（默认）"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioVersionMax"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="仅显示最高版本"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部保存栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="12dp">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/btn_primary"
            android:backgroundTint="@null"
            android:text="保存设置"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
